# ─── PRODUCTION API CONFIG ──────────────────────────────────────────────────
# Using relative /api routes through the domain's reverse proxy (Nginx / Cloudflare)
VITE_API_URL=/api

# ─── GATEKEEPER PRODUCTION ACCESS ──────────────────────────────────────────
# Ensure Gatekeeper is disabled in production so search crawlers and users are not blocked
VITE_ENABLE_GATEKEEPER=false