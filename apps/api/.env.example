# ==============================================================================
# MaiHoonNa Primary API (apps/api) — Environment Configuration Template
# ==============================================================================

# ─── 1. SERVER & RUNTIME SETTINGS ─────────────────────────────────────────────
NODE_ENV=production
PORT=8001
CORS_ORIGIN=*
JSON_PAYLOAD_LIMIT="50mb"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
FRONTEND_URL=https://maihoonna.in/
# Set to 'false' to disable workers on pure API replica instances (auto-handled in PM2 cluster)
RUN_BACKGROUND_WORKERS=true

# ─── 2. DATABASE SETTINGS (POSTGRESQL / RDS) ──────────────────────────────────
# Database Connection Pool sizing for high concurrency
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000

DATABASE_URL="postgresql://user:password@host:5432/maihoonna?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/maihoonna?sslmode=require"

# ─── 3. SECURITY & AUTHENTICATION ─────────────────────────────────────────────
JWT_SECRET=your_super_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d
MHN_APP_SECRET=your_shared_app_secret_between_client_and_server

# ─── 4. REDIS (STREAMS & NOTIFICATIONS) ───────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── 5. NOTIFICATION PROVIDERS (MSG91 / AWS SES / EMAIL) ──────────────────────
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=MAIHNA
MSG91_DLT_TE_ID=your_dlt_template_id

AWS_REGION=ap-south-1
AWS_SES_FROM_EMAIL=notifications@maihoonna.com
# Leave blank if using AWS IAM Roles on EC2/ECS:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── 6. PAYMENT GATEWAY (RAZORPAY) ────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Keep false in production to enforce cryptographic payment signature verification
ENABLE_MOCK_PAYMENTS=false

# ─── 7. FILE & MEDIA STORAGE (AWS S3) ─────────────────────────────────────────
STORAGE_PROVIDER=s3
STORAGE_BUCKET=maihoonna-media-prod
S3_REGION=ap-south-1

# ─── 8. FILE & VISIT IMAGE UPLOAD LIMITS ──────────────────────────────────────
VISIT_IMAGE_MAX_COUNT=10
VISIT_IMAGE_MAX_SIZE_MB=12
VISIT_IMAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif

# ─── 9. LOCATION & MAPS ───────────────────────────────────────────────────────
MAX_SERVICE_RADIUS_KM=50
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GEOFENCE_RADIUS_METERS=50

# ─── 10. CLOUDFLARE TURNSTILE CAPTCHA ─────────────────────────────────────────
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
