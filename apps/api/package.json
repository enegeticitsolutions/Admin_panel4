{
  "name": "api",
  "version": "1.0.0",
  "description": "Backend API for MaiHoonNa",
  "main": "dist/run.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only app/run.ts",
    "build": "npm --prefix ../../packages/notifications run build && prisma generate --schema=../../packages/database/prisma/schema.prisma && tsc",
    "start": "node dist/app/run.js",
    "postinstall": "prisma generate --schema=../../packages/database/prisma/schema.prisma",
    "seed:test": "ts-node --transpile-only prisma/seed_test.ts",
    "prisma:generate": "prisma generate --schema=../../packages/database/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=../../packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@maihoonna/database": "*",
    "@maihoonna/notifications": "*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.105.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.11",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "razorpay": "^2.9.6",
    "twilio": "^5.4.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
