# Admin Backend Environment Variables Example
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173,http://localhost:8081

DATABASE_URL="postgresql://user:password@host:5432/dbname"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

JWT_SECRET=your_jwt_secret
REFRESH_SECRET=your_refresh_secret

# ── FILE & MEDIA STORAGE (AWS S3) ──────────────────────────────────────────────
STORAGE_PROVIDER=s3                        # 's3' for production/staging, 'supabase' for local dev
STORAGE_BUCKET=maihoonna-media-staging     # Change to maihoonna-media-prod on production
AWS_REGION=ap-south-1

# AWS Credentials — choose ONE of these approaches:
#   Option A (Recommended for EC2/ECS): Leave blank — IAM instance role / Task Role provides creds automatically
#   Option B (Ubuntu plain server or local dev): Set explicit IAM user credentials below
AWS_ACCESS_KEY_ID=                         # Set this on plain Ubuntu server (not needed on EC2 with instance profile)
AWS_SECRET_ACCESS_KEY=                     # Set this on plain Ubuntu server (not needed on EC2 with instance profile)

# ── CLOUDFLARE TURNSTILE CAPTCHA ───────────────────────────────────────────────
# Set the secret key matching your environment (Staging, Preprod, or Production)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
